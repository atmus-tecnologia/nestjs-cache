{
  "name": "@atmus/nestjs-cache",
  "version": "1.0.0",
  "description": "NestJS - Redis Cache integration",
  "author": "Atmus Tecnologia <contato@atmustecnologia.com.br>",
  "license": "MIT",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "npm run build && node --test test/*.test.cjs",
    "check": "npm run typecheck && npm test && npm run test:package",
    "test:package": "node scripts/check-package.cjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "nestjs",
    "redis",
    "cache",
    "nestjs-cache"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atmus-tecnologia/nestjs-cache.git"
  },
  "bugs": {
    "url": "https://github.com/atmus-tecnologia/nestjs-cache/issues"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "dependencies": {
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/testing": "^12.3.3",
    "@types/node": "^26.6.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "~5.9.3"
  },
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/atmus-tecnologia/nestjs-cache#readme",
  "engines": {
    "node": ">=22.12.0"
  }
}
